---
import { ClientRouter } from "astro:transitions";
import { DeskBackdrop, FoldStage, Paper, SiteHeader } from "../components/ui";
import { siteName } from "../lib/blog";
import { sectionForPath, type Section } from "../lib/sections";
import initialPreferences from "../scripts/initial-preferences.js?raw";
import deskTexture from "../scripts/desk-texture.cjs?raw";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  current?: Section | null;
  ruling?: "ruled" | "grid";
}
const { title, description = "折间，一本关于折纸、设计、代码和日常散步的个人手记。",
  current = sectionForPath(Astro.url.pathname), ruling = "ruled" } = Astro.props;
const documentTitle = title ? title + " · " + siteName : siteName + " · Fold Journal";
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1e7d8" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="data:," />
    <title>{documentTitle}</title>
    <script is:inline set:html={initialPreferences}></script>
    <style id="desk-texture" is:inline transition:persist="desk-texture"></style>
    <script is:inline set:html={deskTexture}></script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <DeskBackdrop />
    <SiteHeader current={current} />
    <Paper section={current} ruling={ruling}><slot /></Paper>
    <FoldStage />
    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
