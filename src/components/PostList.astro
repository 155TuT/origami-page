---
import { categoryURL, isoDate, postURL, printedDate, type Post } from "../lib/blog";
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => <li>
    <div class="post-date"><time datetime={isoDate(post.data.date)}>{printedDate(post.data.date)}</time><a href={categoryURL(post.data.category)}>{post.data.category}</a></div>
    <div class="post-summary"><a class="post-title" href={postURL(post)}>{post.data.title}<span class="list-arrow" aria-hidden="true">↗</span></a><p>{post.data.description}</p></div>
  </li>)}
</ul>
