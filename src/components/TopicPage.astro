---
import Site from "../layouts/Site.astro";
import { ContentColumns, JournalAside, PageHeading, PostList } from "./ui";
import type { Post } from "../lib/blog";
import { sectionURL } from "../lib/sections";
interface Props { name: string; type: "tag" | "category"; posts: Post[]; all: Post[]; }
const { name, type, posts, all } = Astro.props;
---
<Site title={name} ruling="grid">
  <ContentColumns>
    <PageHeading title={name} description={`${posts.length} 篇手记`}
      eyebrow={type === "tag" ? "← 全部标签" : "← 全部文章"}
      eyebrowHref={sectionURL(type === "tag" ? "tags" : "articles")} />
    <PostList posts={posts} />
    <JournalAside slot="aside" posts={all} />
  </ContentColumns>
</Site>
