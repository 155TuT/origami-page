---
import Site from "../layouts/Site.astro";
import { ContentColumns, JournalAside, PageHeading, PostList } from "./ui";
import { href, type Post } from "../lib/blog";
interface Props { name: string; type: "tag" | "category"; posts: Post[]; all: Post[]; }
const { name, type, posts, all } = Astro.props;
---
<Site title={name} current={type === "tag" ? "tags" : "archive"} ruling="grid">
  <ContentColumns>
    <PageHeading title={name} description={`${posts.length} 篇手记`}
      eyebrow={type === "tag" ? "← 全部标签" : "← 文章归档"}
      eyebrowHref={href(type === "tag" ? "tags/" : "archives/")} />
    <PostList posts={posts} />
    <JournalAside slot="aside" posts={all} />
  </ContentColumns>
</Site>
