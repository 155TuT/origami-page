---
import type { Post } from "../../lib/blog";
import { isDraft } from "../../lib/blog";
import AlbumPhoto from "./AlbumPhoto.astro";
import PageHeading from "./PageHeading.astro";
import Plate from "./Plate.astro";
import PostDate from "./PostDate.astro";
import Prose from "./Prose.astro";
import TagList from "./TagList.astro";

interface Props { post: Post; }
const { post } = Astro.props;
const { title, date, tags, art, cover, category } = post.data;
const draft = isDraft(post);
---
<article>
  <PageHeading title={title}>
    <div class="meta">
      <PostDate date={date} />{draft && category && <span>{category}</span>}
    </div>
  </PageHeading>
  {cover ? <AlbumPhoto photo={cover} eager /> : art && <Plate art={art} />}
  <Prose><slot /></Prose>
  {!draft && <TagList variant="article" tags={tags.map(name => ({ name }))} />}
</article>
<style>
  .meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin-block-start: var(--space-4); color: var(--muted); font-size: var(--text-meta); }
</style>
