---
interface Props { title: string; visuallyHidden?: boolean; }
const { title, visuallyHidden = false } = Astro.props;
---
{visuallyHidden ? <h1 id="page-title" class="visually-hidden">{title}</h1> : (
  <header class="content-heading">
    <h1 id="page-title">{title}</h1>
    <slot />
  </header>
)}

<style>
  .content-heading { padding-block-end: var(--space-6); border-block-end: 1px solid var(--line-dark); }
  .content-heading h1 {
    margin-block-end: var(--space-2);
    font: var(--weight-heading) var(--text-title)/1.2 var(--serif);
    letter-spacing: -.055em;
    text-spacing-trim: space-all;
    overflow-wrap: anywhere;
  }
</style>
