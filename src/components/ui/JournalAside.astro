---
import { categoryURL, groupPosts, href, type Post } from "../../lib/blog";
import ActionLink from "./ActionLink.astro";
import Sidebar from "./Sidebar.astro";

interface Props { posts: Post[]; }
const { posts } = Astro.props;
const groups = groupPosts(posts, "category");
---
<Sidebar label="浏览手记">
  <h2>手记栏目</h2>
  <ul>{[...groups].map(([name, entries]) => (
    <li><a href={categoryURL(name)}><span>{name}</span><small>{entries.length} 篇</small></a></li>
  ))}</ul>
  <section>
    <h2>关于折间</h2>
    <p>纸上留下折痕，也留下设计、代码和路上偶遇的风景。</p>
    <ActionLink href={href("about/")} arrow="↗">关于这本手记</ActionLink>
  </section>
</Sidebar>

<style>
  ul { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--line);
    font-size: var(--text-ui);
  }
  li a:hover { color: var(--accent); }
  small { color: var(--faint); font: var(--type-count); }
  section { margin-block-start: var(--space-6); }
  p { margin-block: var(--space-2); color: var(--muted); font-size: var(--text-small); line-height: 1.85; }
</style>
