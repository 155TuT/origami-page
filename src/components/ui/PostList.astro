---
import type { PublicEntry } from "../../lib/blog";
import PostDate from "./PostDate.astro";
interface Props { entries: PublicEntry[]; empty?: string; covers?: boolean; }
const { entries, empty = "暂无公开内容。", covers = false } = Astro.props;
---
{entries.length ? <ul class="post-list">
  {entries.map(entry => (
    <li data-entry-url={entry.url} class:list={{ illustrated: covers && entry.cover }}>
      {covers && entry.cover && <div class="thumb">
        <img src={entry.cover.src} alt={entry.cover.alt} loading="lazy" />
      </div>}
      <div class="entry">
        <div class="post-date">
          <PostDate date={entry.date} />
        </div>
        <a class="post-title" href={entry.url}>{entry.title}<span aria-hidden="true">↗</span></a>
      </div>
    </li>
  ))}
</ul> : <p class="empty">{empty}</p>}

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding-block: var(--space-5); border-block-end: 1px solid var(--line); }
  li.illustrated { position: relative; display: grid; grid-template-columns: minmax(100px, .45fr) minmax(0, 1fr); align-items: center; gap: var(--space-6); }
  .illustrated .post-title::after { content: ""; position: absolute; inset: 0; }
  .thumb { display: grid; align-items: center; background: var(--plate); }
  .thumb img { display: block; width: 100%; height: auto; }
  .post-date { display: flex; flex-wrap: wrap; gap: var(--space-3); color: var(--faint); font-size: var(--text-meta); }
  .post-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    font: var(--weight-heading) var(--text-post-title)/1.5 var(--serif);
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
  }
  .post-title:hover { color: var(--accent); }
  .post-title span { color: var(--faint); font: var(--text-body)/1 var(--sans); }
  .empty { margin-block: var(--space-6); color: var(--muted); font-size: var(--text-small); }
  @media (max-width: 700px) {
    li.illustrated { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  }
</style>
