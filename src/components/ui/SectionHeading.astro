---
interface Props { title: string; visuallyHidden?: boolean; }
const { title, visuallyHidden = false } = Astro.props;
---
<div class={visuallyHidden ? "visually-hidden" : "section-heading"}><h2>{title}</h2><slot /></div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--line-dark);
  }
  h2 { font: var(--weight-semibold) var(--text-ui)/1.5 var(--sans); color: var(--muted); }
</style>
