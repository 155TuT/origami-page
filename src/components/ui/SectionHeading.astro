---
interface Props { title: string; variant?: "section" | "year"; }
const { title, variant = "section" } = Astro.props;
---
<div class:list={["section-heading", variant]}><h2>{title}</h2><slot /></div>

<style>
  .section {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--line-dark);
  }
  .section h2 { font: var(--weight-heading) var(--text-section)/1.4 var(--serif); letter-spacing: -.04em; }
  .year { margin-block-start: var(--space-5); }
  .year h2 { color: var(--accent); font: italic var(--text-year)/1.4 var(--latin-serif); }
  @media (max-width: 1084px) {
    .section { padding-block-end: var(--space-3); }
  }
</style>
