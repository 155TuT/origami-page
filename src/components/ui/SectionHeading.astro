---
interface Props { title: string; }
const { title } = Astro.props;
---
<div class="section-heading"><h2>{title}</h2><slot /></div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--line-dark);
  }
  h2 { font: var(--weight-heading) var(--text-section)/1.4 var(--serif); letter-spacing: -.04em; }
  @media (max-width: 1084px) {
    .section-heading { padding-block-end: var(--space-3); }
  }
</style>
