---
import { isoDate, printedDate } from "../../lib/blog";

interface Props { date: Date; clock?: boolean; }
const { date, clock = false } = Astro.props;
---
<time class:list={{ "with-clock": clock }} datetime={isoDate(date)}>
  {clock && <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z" />
  </svg>}{printedDate(date)}
</time>

<style>
  time { font: var(--text-meta)/1.6 var(--serif); }
  .with-clock { display: inline-flex; align-items: center; gap: var(--space-1); white-space: nowrap; }
  svg { width: var(--text-ui); height: var(--text-ui); }
</style>
