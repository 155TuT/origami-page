---
import { sectionURL } from "../../lib/sections";
import { profile } from "../../lib/profile";
import ActionLink from "./ActionLink.astro";
import ActionRow from "./ActionRow.astro";
import Plate from "./Plate.astro";
---
<section class="cover">
  <div class="cover-copy">
    <h1>{profile.name ? `你好，我是${profile.name}。` : "欢迎来折间。"}</h1>
    <p>{profile.introduction}</p>
    <ActionRow>
      <ActionLink variant="primary" href={sectionURL("about")} arrow="↗">查看简历</ActionLink>
    </ActionRow>
  </div>
  <Plate variant="cover" art="crane" />
</section>

<style>
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--line-dark);
    background: var(--surface);
    box-shadow: var(--shadow-cover);
  }
  .cover-copy { display: grid; align-content: center; padding: var(--paper-inset); }
  h1 {
    font: var(--weight-bold) var(--text-cover)/1.12 var(--serif);
    letter-spacing: -.065em;
    overflow-wrap: anywhere;
  }
  p {
    max-width: 29em;
    margin-top: var(--space-4);
    color: var(--muted);
    font: var(--weight-regular) var(--text-cover-description)/var(--leading-prose) var(--serif);
  }
  @media (max-width: 1084px) {
    .cover { grid-template-columns: minmax(0, 1fr); }
    .cover-copy { padding: var(--space-4); }
  }
</style>
