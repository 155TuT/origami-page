---
import { tagAnchor, tagURL } from "../../lib/blog";

interface Props {
  tags: { name: string; count?: number }[];
  variant?: "index" | "article";
  label?: string;
}
const { tags, variant = "index", label = variant === "article" ? "内容标签" : "全部标签" } = Astro.props;
---
{tags.length > 0 && (
  <ul class:list={["tag-list", variant]} aria-label={label}>
    {tags.map(({ name, count }) => (
      <li data-tag-name={variant === "index" ? name : undefined}>
        <a class="tag-query" href={tagURL(name)}>
          <span>{variant === "article" && "# "}{name}</span>
          {count !== undefined && <small>{count} 项</small>}
        </a>
        {variant === "article" && <noscript>
          <a href={tagURL(name) + "#" + encodeURIComponent(tagAnchor(name))}># {name}</a>
        </noscript>}
      </li>
    ))}
  </ul>
)}
{variant === "article" && <noscript><style is:inline>.tag-list.article .tag-query { display: none; }</style></noscript>}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article { margin-block-start: var(--space-8); }
  li { max-width: 100%; }
  a {
    display: inline-flex;
    max-width: 100%;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow-wrap: anywhere;
  }
  a:hover { border-color: var(--accent); }
  small { color: var(--faint); font: var(--type-count); }
  .article a { padding: 3px var(--space-2); color: var(--accent); font-size: var(--text-meta); }
</style>
