---
import { categoryURL, groupPosts, href, type Post } from "../lib/blog";
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const groups = groupPosts(posts, "category");
---
<aside class="journal-aside" aria-label="浏览手记">
  <h2>手记栏目</h2>
  <ul class="category-list">{[...groups].map(([name, entries]) => <li><a href={categoryURL(name)}><span>{name}</span><small>{entries.length} 篇</small></a></li>)}</ul>
  <div class="aside-about"><h2>关于折间</h2><p>纸上留下折痕，也留下设计、代码和路上偶遇的风景。</p><a class="text-link" href={href("about/")}>关于这本手记 <span aria-hidden="true">↗</span></a></div>
</aside>
