<details class="reading-settings" data-settings>
  <summary aria-label="阅读设置" title="阅读设置">
    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.55" aria-hidden="true"><path d="M3 7h5m5 0h8M3 17h9m5 0h4"/><circle cx="10.5" cy="7" r="2.5"/><circle cx="14.5" cy="17" r="2.5"/></svg>
    <span>阅读设置</span>
  </summary>
  <div class="settings-panel">
    <label><span>深色模式</span><input type="checkbox" role="switch" data-setting="theme" /></label>
    <label><span>减少动态效果</span><input type="checkbox" role="switch" data-setting="reduce" /></label>
    <label><span>并行取文与收纸</span><input type="checkbox" role="switch" data-setting="parallel" aria-describedby="parallel-hint" /></label>
    <p id="parallel-hint">开启后，点击链接就开始收纸。关闭时，等下一页准备好再收纸。</p>
  </div>
</details>
