---
import { render } from "astro:content";
import Site from "../../layouts/Site.astro";
import Plate from "../../components/Plate.astro";
import { allPosts, categoryURL, href, isoDate, postURL, printedDate, tagURL } from "../../lib/blog";
export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i-1], older: posts[i+1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, category, tags, ruling, art } = post.data;
const contents = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Site title={title} description={description} current="archive" ruling={ruling}>
  <div class="interior-grid article-grid">
    <div class="article-paper">
      <article>
        <header class="article-heading">
          <a class="eyeline" href={categoryURL(category)}>{category}</a>
          <h1>{title}</h1>
          <div class="article-meta"><time datetime={isoDate(date)}>{printedDate(date)}</time><span aria-hidden="true">/</span><a href={href("archives/")}>文章归档</a></div>
        </header>
        <p class="article-deck">{description}</p>
        {art && <Plate art={art} />}
        <div class="prose"><Content /></div>
        {tags.length > 0 && <ul class="article-tags" aria-label="文章标签">{tags.map(tag => <li><a href={tagURL(tag)}># {tag}</a></li>)}</ul>}
      </article>
      <nav class="post-neighbors" aria-label="相邻文章">
        {newer && <a rel="prev" href={postURL(newer)}><small>← 上一篇</small><strong>{newer.data.title}</strong></a>}
        {older && <a rel="next" class="older" href={postURL(older)}><small>下一篇 →</small><strong>{older.data.title}</strong></a>}
      </nav>
    </div>
    <aside class="article-aside">{contents.length > 0 && <nav aria-label="本篇目录"><h2>本篇目录</h2><ol>{contents.map(h => <li class:list={{subhead:h.depth === 3}}><a href={"#" + h.slug}>{h.text}</a></li>)}</ol></nav>}<a class="text-link" href={href("archives/")}>返回归档 <span aria-hidden="true">↗</span></a></aside>
  </div>
</Site>
