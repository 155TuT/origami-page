---
import Site from "../layouts/Site.astro";
import { ActionLink, ContentColumns, FeaturedPost, JournalAside, PostList, SectionHeading } from "../components/ui";
import { allPosts, href } from "../lib/blog";
const posts = await allPosts();
const [lead, ...more] = posts;
---
<Site current="home" ruling={lead?.data.ruling}>
  {lead && <FeaturedPost post={lead} />}
  <ContentColumns>
    <section>
      <SectionHeading title="近期文章">
        <ActionLink href={href("archives/")} arrow="→">全部归档</ActionLink>
      </SectionHeading>
      <PostList posts={more.slice(0, 5)} />
    </section>
    <JournalAside slot="aside" posts={posts} />
  </ContentColumns>
</Site>
