---
import Site from "../../layouts/Site.astro";
import { PageHeading, TagList } from "../../components/ui";
import { allPublicEntries } from "../../lib/blog";
import { groupByTag } from "../../lib/public-index";

const groups = groupByTag(await allPublicEntries());
const tags = [...groups].map(([name, entries]) => ({ name, count: entries.length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"));
---
<Site title="全部标签" current={null} ruling="grid">
  <PageHeading title="全部标签" />
  {tags.length ? <TagList tags={tags} /> : <p>暂无公开标签。</p>}
</Site>
