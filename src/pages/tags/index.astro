---
import Site from "../../layouts/Site.astro";
import JournalAside from "../../components/JournalAside.astro";
import { allPosts, groupPosts, tagURL } from "../../lib/blog";
const posts = await allPosts();
const tags = [...groupPosts(posts,"tags")].sort((a,b) => b[1].length - a[1].length || a[0].localeCompare(b[0],"zh-CN"));
---
<Site title="标签" current="tags" ruling="grid"><div class="interior-grid">
  <div><header class="page-heading"><p class="eyeline">按主题浏览</p><h1>标签</h1><p>{tags.length} 个主题，{posts.length} 篇手记</p></header>
    <div class="tag-index">{tags.map(([tag, entries]) => <a href={tagURL(tag)}><span>{tag}</span><small>{entries.length} 篇</small></a>)}</div>
  </div><JournalAside posts={posts} />
</div></Site>
