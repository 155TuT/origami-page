---
import Site from "../layouts/Site.astro";
import { PageHeading, Prose } from "../components/ui";
import { profile, contactEmail } from "../lib/profile";
import { sectionURL } from "../lib/sections";
---
<Site title="关于我" description={profile.introduction}>
  <article>
    <PageHeading title={profile.name || "关于我"} />
    <Prose>
      <p>{profile.introduction}</p>
      <h2>经历</h2>
      {profile.experience.length ? profile.experience.map(item => (
        <p><strong>{item.title}</strong> · {item.period}{item.description && <><br />{item.description}</>}</p>
      )) : <p>暂无公开经历。</p>}
      <h2>代表项目</h2>
      <p><a href={sectionURL("works", "fold-journal/")}>折间</a></p>
      <h2 id="contact">联系方式</h2>
      {contactEmail ? <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p> : <p>邮箱暂未公开。</p>}
    </Prose>
  </article>
</Site>
