---
import Site from "../layouts/Site.astro";
import { ContentColumns, JournalAside, PageHeading, PostList, SectionHeading } from "../components/ui";
import { allPosts, groupPosts } from "../lib/blog";
const posts = await allPosts();
---
<Site title="文章归档" current="archive">
  <ContentColumns>
    <PageHeading eyebrow="按时间浏览" title="文章归档" description={`共 ${posts.length} 篇手记`} />
    {[...groupPosts(posts, "year")].map(([year, entries]) => (
      <section><SectionHeading variant="year" title={year} /><PostList posts={entries} /></section>
    ))}
    <JournalAside slot="aside" posts={posts} />
  </ContentColumns>
</Site>
