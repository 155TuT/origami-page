---
import Site from "../layouts/Site.astro";
import { ActionLink, ActionRow, PageHeading } from "../components/ui";
import { href } from "../lib/blog";
---
<Site title="找不到这一页" current="home">
  <section>
    <PageHeading eyebrow="404" title="找不到这一页" description="可以回到首页，或在归档中查找文章。" ruled={false} />
    <ActionRow>
      <ActionLink variant="primary" href={href()} arrow="→">返回首页</ActionLink>
      <ActionLink href={href("archives/")} arrow="↗">文章归档</ActionLink>
    </ActionRow>
  </section>
</Site>
