---
import Site from "../layouts/Site.astro";
import { ActionLink, ActionRow, PageHeading } from "../components/ui";
import { sectionURL } from "../lib/sections";
---
<Site title="找不到这一页" current={null}>
  <section>
    <PageHeading title="找不到这一页" ruled={false} />
    <ActionRow>
      <ActionLink variant="primary" href={sectionURL("home")} arrow="→">返回首页</ActionLink>
      <ActionLink href={sectionURL("articles")} arrow="↗">全部文章</ActionLink>
    </ActionRow>
  </section>
</Site>
