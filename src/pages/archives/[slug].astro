---
import { render } from "astro:content";
import Site from "../../layouts/Site.astro";
import { ContentColumns, PostArticle, PostNeighbors, TableOfContents } from "../../components/ui";
import { allPosts, entrySlug } from "../../lib/blog";
export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({ params: { slug: entrySlug(post) }, props: { post, newer: posts[i-1], older: posts[i+1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, ruling } = post.data;
---
<Site title={title} description={description} ruling={ruling}>
  <ContentColumns>
    <PostArticle post={post}><Content /></PostArticle>
    <PostNeighbors newer={newer} older={older} />
    <TableOfContents slot="aside" headings={headings} />
  </ContentColumns>
</Site>
